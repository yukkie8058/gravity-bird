code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform float speed = 1.0;
instance uniform float frequency = 1.0;



void vertex() {
// Input:14
	float n_out14p0 = TIME;


// FloatParameter:6
	float n_out6p0 = speed;


// Reroute:9
	float n_out9p0 = n_out6p0;


// Reroute:8
	float n_out8p0 = n_out9p0;


// Input:15
	vec2 n_out15p0 = UV;
	float n_out15p1 = n_out15p0.r;


// MultiplyAdd:12
	float n_out12p0 = (n_out14p0 * n_out8p0) + n_out15p1;


// FloatFunc:13
	float n_out13p0 = abs(n_out12p0);


// FloatParameter:11
	float n_out11p0 = frequency;


// Reroute:10
	float n_out10p0 = n_out11p0;


// Reroute:7
	float n_out7p0 = n_out10p0;


// FloatOp:5
	float n_out5p0 = n_out13p0 * n_out7p0;


// Input:16
	vec4 n_out16p0 = COLOR;


	vec3 n_out3p0;
// ColorFunc:3
	{
		vec3 c = vec3(n_out16p0.xyz);
		vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
		vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
		vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
		float d = q.x - min(q.w, q.y);
		float e = 1.0e-10;
		n_out3p0 = vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
	}
	float n_out3p2 = n_out3p0.g;
	float n_out3p3 = n_out3p0.b;


// VectorCompose:4
	vec3 n_out4p0 = vec3(n_out5p0, n_out3p2, n_out3p3);


	vec3 n_out2p0;
// ColorFunc:2
	{
		vec3 c = n_out4p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out2p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Output:0
	COLOR.rgb = n_out2p0;


}
"
